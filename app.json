{
  "expo": {
    "name": "Yomi",
    "slug": "Yomi",
    "version": "0.3.1",
    "orientation": "default",
    "scheme": [
      "yomi",
      "com.kuyi.yomi"
    ],
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.kuyi.yomi",
      "versionCode": 20,
      "adaptiveIcon": {
        "backgroundColor": "#2c76bc",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "scheme": "content"
            },
            {
              "scheme": "file"
            },
            {
              "mimeType": "*/*",
              "pathPattern": ".*\\.yomi"
            },
            {
              "mimeType": "*/*",
              "pathPattern": ".*\\.apkg"
            },
            {
              "mimeType": "application/octet-stream"
            },
            {
              "mimeType": "application/json"
            }
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2c76bc",
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#2c76bc"
          }
        }
      ],
      "expo-image",
      "expo-sqlite",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Permite a Yomi acceder al micrófono para practicar tu pronunciación en voz alta."
        }
      ],
      "expo-sharing",
      "expo-web-browser",
      "expo-localization",
      "expo-video",
      [
        "./plugins/withVosk",
        {
          "models": [
            "assets/model-ja-jp"
          ]
        }
      ],
      "./plugins/withAndroidSigning",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.facebook.react.turbomodule.** { *; }\n-keepclassmembers class * {\n    @com.facebook.react.uimanager.annotations.ReactProp <methods>;\n    @com.facebook.react.uimanager.annotations.ReactPropGroup <methods>;\n}\n-dontwarn com.facebook.react.**\n\n-keep class com.swmansion.reanimated.** { *; }\n-keep class com.swmansion.gesturehandler.** { *; }\n-keep class com.swmansion.rnscreens.** { *; }\n-keep class com.swmansion.worklets.** { *; }\n\n-keep class expo.modules.** { *; }\n-dontwarn expo.modules.**\n\n-dontwarn java.awt.**\n\n-keep class org.vosk.** { *; }\n-keep class com.alphacephei.vosk.** { *; }\n-keep class com.vosk.** { *; }\n-keep class com.sun.jna.** { *; }\n-keep class * extends com.sun.jna.** { *; }\n-keepclassmembers class * extends com.sun.jna.** { public *; }\n-dontwarn com.sun.jna.**\n-dontwarn org.vosk.**\n-dontwarn com.alphacephei.vosk.**\n\n-keep class com.imxiqi.audiopcmstream.** { *; }\n\n-keep class com.google.android.play.core.** { *; }\n-keep class com.sudoplz.rninappupdates.** { *; }\n\n-keep class com.learnium.RNDeviceInfo.** { *; }\n-keep class com.horcrux.svg.** { *; }"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cad355df-85ed-4f8e-b0e3-af82f2f16107"
      }
    },
    "owner": "fedeosorio24",
    "updates": {
      "url": "https://u.expo.dev/cad355df-85ed-4f8e-b0e3-af82f2f16107"
    },
    "ios": {
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition.",
        "NSMicrophoneUsageDescription": "Permite a Yomi acceder al micrófono para practicar tu pronunciación en voz alta.",
        "LSApplicationQueriesSchemes": [
          "itms-apps"
        ]
      }
    }
  }
}
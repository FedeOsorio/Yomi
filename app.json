{
  "expo": {
    "name": "Yomi",
    "slug": "Yomi",
    "version": "0.2.701",
    "orientation": "default",
    "scheme": [
      "yomi",
      "com.kuyi.yomi"
    ],
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.kuyi.yomi",
      "versionCode": 15,
      "adaptiveIcon": {
        "backgroundColor": "#2d74b2",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "scheme": "content"
            },
            {
              "scheme": "file"
            },
            {
              "mimeType": "*/*",
              "pathPattern": ".*\\.yomi"
            },
            {
              "mimeType": "*/*",
              "pathPattern": ".*\\.apkg"
            },
            {
              "mimeType": "application/octet-stream"
            },
            {
              "mimeType": "application/json"
            }
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2d74b2",
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain"
        }
      ],
      "expo-image",
      "expo-sqlite",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Permite a Yomi acceder al micrófono para practicar tu pronunciación en voz alta."
        }
      ],
      "expo-sharing",
      "expo-web-browser",
      "expo-localization",
      "expo-video",
      [
        "react-native-vosk",
        {
          "models": [
            "assets/model-ja-jp"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cad355df-85ed-4f8e-b0e3-af82f2f16107"
      }
    },
    "owner": "fedeosorio24",
    "updates": {
      "url": "https://u.expo.dev/cad355df-85ed-4f8e-b0e3-af82f2f16107"
    },
    "ios": {
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition.",
        "NSMicrophoneUsageDescription": "Permite a Yomi acceder al micrófono para practicar tu pronunciación en voz alta.",
        "LSApplicationQueriesSchemes": [
          "itms-apps"
        ]
      }
    }
  }
}